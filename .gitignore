# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/

# Unit test / coverage / linter caches
htmlcov/
.coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environments & Virtual Environments
.env
.env.*
!.env.example
.venv
env/
venv/
.aegis/

# Secrets, Credentials, and Keys (Strict Zero-Secret Policy)
*.pem
*.key
*.cert
*.pfx
*.p12
credentials.json
token.json
secrets/

# AI Model weights and large binaries (Excluded per specification)
*.gguf
*.bin
*.pt
*.pth
*.onnx
*.safetensors
models/weights/
runtime/models/

# Database and local state (Transient / caches)
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm
*.log
data/local/
runtime/cache/
runtime/logs/
runtime/staging/
runtime/scratch/

# Operating System Files (Windows)
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# IDE and Editor files
.idea/
.vscode/
*.swp
*~
